From 31541850d6e2d556ffbaf79a2f25069bac899475 Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Fri, 9 Oct 2026 21:44:02 -0500
Subject: [PATCH] Load the external llama.cpp libraries from the conda prefix

llama.cpp is a separate conda package, so libllama, libggml and libmtmd are
in the environment's library directory, not bundled in <package>/lib. When
the bundled directory does not exist, use that directory, resolved from this
file's location, as the loader's base path. All candidates stay absolute
paths, so the OS never resolves a bare library name from the working
directory or other ambient search locations, and upstream's Windows DLL
directory registration gets an existing directory for llama, ggml and mtmd.
An explicit override such as LLAMA_CPP_LIB_PATH is used unchanged.

Replaces the earlier 'Adapt shared library relocation' patch by Julien
Jerphanion (conda-forge feedstock), which appended bare library names to the
candidate list.
---
 llama_cpp/_ctypes_extensions.py | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/llama_cpp/_ctypes_extensions.py b/llama_cpp/_ctypes_extensions.py
index 02cee8a..748498b 100644
--- a/llama_cpp/_ctypes_extensions.py
+++ b/llama_cpp/_ctypes_extensions.py
@@ -21,10 +21,26 @@ from typing_extensions import TypeAlias
 
 _EMSCRIPTEN_SIDE_MODULE_SUFFIX = ".cpython-00-wasm32-emscripten.so"
 
+# conda: llama.cpp is a separate package, so its shared libraries live in the
+# environment's library directory, not in `<package>/lib`. Resolved from this
+# file's location (not from the process environment or working directory):
+#   <prefix>/lib/pythonX.Y/site-packages/llama_cpp -> <prefix>/lib
+#   <prefix>/Lib/site-packages/llama_cpp           -> <prefix>/Library/bin
+_PACKAGE_DIR = pathlib.Path(os.path.abspath(os.path.dirname(__file__)))
+_CONDA_LIBRARY_DIR = (
+    _PACKAGE_DIR.parent.parent.parent / "Library" / "bin"
+    if sys.platform == "win32"
+    else _PACKAGE_DIR.parent.parent.parent
+)
+
 
 # Load the library
 def load_shared_library(lib_base_name: str, base_path: pathlib.Path):
     """Platform independent shared library loader"""
+    # Only the default bundled directory is redirected; an explicit override
+    # (e.g. LLAMA_CPP_LIB_PATH) is used as given. Candidates stay absolute paths.
+    if base_path == _PACKAGE_DIR / "lib" and not base_path.is_dir():
+        base_path = _CONDA_LIBRARY_DIR
     # Searching for the library in the current directory under the name "libllama" (default name
     # for llamacpp) and "llama" (default name for this repo)
     lib_paths: List[pathlib.Path] = []
@@ -104,7 +120,8 @@ def load_shared_library(lib_base_name: str, base_path: pathlib.Path):
                 raise RuntimeError(f"Failed to load shared library '{lib_path}': {e}")
 
     raise FileNotFoundError(
-        f"Shared library with base name '{lib_base_name}' not found"
+        f"Shared library with base name '{lib_base_name}' not found in "
+        f"{[str(p) for p in lib_paths]}"
     )
 
 
